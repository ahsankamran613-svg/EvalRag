# Copy this file to .env when we reach Milestone 2 (Embeddings & Generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: Free-tier Cohere API key for 0-RAM cloud reranking (rerank-v3.5)
# Leave blank to automatically fall back to local FlashRank ONNX (~34MB, no PyTorch)
COHERE_API_KEY=
RERANKER_PROVIDER=auto

# Chunking settings (Milestone 1)
CHUNK_MAX_WORDS=350
CHUNK_OVERLAP_WORDS=50

# Retrieval & Evaluation settings (Milestones 2-4)
TOP_K_CANDIDATES=20
TOP_K_FINAL=5
RRF_K=60
EVAL_REQUEST_DELAY_SEC=2.0
